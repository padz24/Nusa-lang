// Self-host lexer Nusa (Phase 38, v1.19.0 — bootstrap langkah 1).
// Menokenisasi sumber Nusa dan mencetak satu baris per token:
// kind|lexeme|line|col (escape IDENTIK dengan `nusa lex`; lihat
// docs/selfhosting.md untuk tabel escape + batas yang jujur).
//
// Streaming (tanpa buffer token): butuh file_read + print saja.
// Pola loop: batas `lim` yang diciutkan (tanpa break di Nusa v1);
// semua loop maju strikt → terminasi terjamin.
// Batasan v1: tanpa overflow-check literal (korpus valid tak memicu);
// \0 dalam string tak terwakili string Nusa (korpus dijamin bebas).
import string;
// ---- klasifikasi karakter (tanpa operator bitwise/logis di v1) ----
fn sh_is_digit(c: string) -> bool {
    return str_contains("0123456789", c);
}
fn sh_is_alpha(c: string) -> bool {
    return str_contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", c);
}
fn sh_is_alnum(c: string) -> bool {
    return str_contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789", c);
}
fn sh_is_space(c: string) -> bool {
    if str_eq(c, " ") {
        return true;
    }
    if str_eq(c, "\t") {
        return true;
    }
    if str_eq(c, "\r") {
        return true;
    }
    return false;
}
// ---- peta keyword → nama kind tokenKindName ----
fn sh_keyword(word: string) -> string {
    if str_eq(word, "fn") {
        return "'fn'";
    }
    if str_eq(word, "let") {
        return "'let'";
    }
    if str_eq(word, "return") {
        return "'return'";
    }
    if str_eq(word, "if") {
        return "'if'";
    }
    if str_eq(word, "else") {
        return "'else'";
    }
    if str_eq(word, "while") {
        return "'while'";
    }
    if str_eq(word, "true") {
        return "'true'";
    }
    if str_eq(word, "false") {
        return "'false'";
    }
    if str_eq(word, "i64") {
        return "'i64'";
    }
    if str_eq(word, "bool") {
        return "'bool'";
    }
    if str_eq(word, "string") {
        return "'string'";
    }
    if str_eq(word, "void") {
        return "'void'";
    }
    if str_eq(word, "struct") {
        return "'struct'";
    }
    if str_eq(word, "import") {
        return "'import'";
    }
    if str_eq(word, "type") {
        return "'type'";
    }
    if str_eq(word, "trait") {
        return "'trait'";
    }
    if str_eq(word, "impl") {
        return "'impl'";
    }
    if str_eq(word, "for") {
        return "'for'";
    }
    if str_eq(word, "self") {
        return "'self'";
    }
    if str_eq(word, "match") {
        return "'match'";
    }
    if str_eq(word, "enum") {
        return "'enum'";
    }
    if str_eq(word, "extern") {
        return "'extern'";
    }
    if str_eq(word, "async") {
        return "'async'";
    }
    if str_eq(word, "await") {
        return "'await'";
    }
    if str_eq(word, "macro") {
        return "'macro'";
    }
    if str_eq(word, "const") {
        return "'const'";
    }
    return "";
}
// ---- escape dump (IDENTIK dengan nusa lex; lihat docs) ----
fn sh_escape(s: string) -> string {
    let out = "";
    let i = 0;
    let n = str_len(s);
    while i < n {
        let c = str_char_at(s, i);
        if str_eq(c, "\\") {
            out = str_concat(out, "\\\\");
        } else {
            if str_eq(c, "\n") {
                out = str_concat(out, "\\n");
            } else {
                if str_eq(c, "\t") {
                    out = str_concat(out, "\\t");
                } else {
                    if str_eq(c, "\r") {
                        out = str_concat(out, "\\r");
                    } else {
                        if str_eq(c, "|") {
                            out = str_concat(out, "\\|");
                        } else {
                            out = str_concat(out, c);
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return out;
}
fn sh_emit(kind: string, lex: string, line: i64, col: i64) -> void {
    print(str_concat(str_concat(str_concat(str_concat(str_concat(str_concat(kind, "|"), sh_escape(lex)), "|"), int_to_str(line)), "|"), int_to_str(col)));
}
// ---- pemetaan escape string "\X" → nilai (cermin lexer C++) ----
fn sh_esc_val(e: string) -> string {
    if str_eq(e, "n") {
        return "\n";
    }
    if str_eq(e, "t") {
        return "\t";
    }
    if str_eq(e, "r") {
        return "\r";
    }
    if str_eq(e, "\"") {
        return "\"";
    }
    if str_eq(e, "\\") {
        return "\\";
    }
    return e;
}
fn main() {
    let src = file_read(process_argv(1));
    let n = str_len(src);
    let pos = 0;
    let line = 1;
    let col = 1;
    while pos < n {
        let c = str_char_at(src, pos);
        if sh_is_space(c) == true {
            pos = pos + 1;
            col = col + 1;
        } else {
            if str_eq(c, "\n") == true {
                pos = pos + 1;
                line = line + 1;
                col = 1;
            } else {
                if sh_is_alpha(c) == true {
                    let tline = line;
                    let tcol = col;
                    let start = pos;
                    let end = pos;
                    let lim = n;
                    while end < lim {
                        if sh_is_alnum(str_char_at(src, end)) == true {
                            end = end + 1;
                        } else {
                            lim = end;
                        }
                    }
                    let word = str_slice(src, start, end);
                    let kind = sh_keyword(word);
                    if str_eq(kind, "") == true {
                        kind = "identifier";
                    }
                    sh_emit(kind, word, tline, tcol);
                    col = col + (end - start);
                    pos = end;
                } else {
                    if sh_is_digit(c) == true {
                        let tline = line;
                        let tcol = col;
                        let start = pos;
                        let end = pos;
                        let lim = n;
                        while end < lim {
                            if sh_is_digit(str_char_at(src, end)) == true {
                                end = end + 1;
                            } else {
                                lim = end;
                            }
                        }
                        let tail = "";
                        if end < n {
                            tail = str_char_at(src, end);
                        }
                        if sh_is_alpha(tail) == true {
                            let end2 = end;
                            let lim2 = n;
                            while end2 < lim2 {
                                if sh_is_alnum(str_char_at(src, end2)) == true {
                                    end2 = end2 + 1;
                                } else {
                                    lim2 = end2;
                                }
                            }
                            sh_emit("unknown", str_slice(src, start, end2), tline, tcol);
                            col = col + (end2 - start);
                            pos = end2;
                        } else {
                            sh_emit("integer literal", str_slice(src, start, end), tline, tcol);
                            col = col + (end - start);
                            pos = end;
                        }
                    } else {
                        if str_eq(c, "\"") == true {
                            let tline = line;
                            let tcol = col;
                            let end = pos + 1;
                            let lim = n;
                            while end < lim {
                                let ch = str_char_at(src, end);
                                if str_eq(ch, "\\") == true {
                                    end = end + 2;
                                } else {
                                    if str_eq(ch, "\"") == true {
                                        lim = end;
                                    } else {
                                        if str_eq(ch, "\n") == true {
                                            lim = end;
                                        } else {
                                            end = end + 1;
                                        }
                                    }
                                }
                            }
                            let closed = false;
                            if end < n {
                                if str_eq(str_char_at(src, end), "\"") == true {
                                    closed = true;
                                }
                            }
                            let val = "";
                            let j = pos + 1;
                            while j < end {
                                let ch = str_char_at(src, j);
                                if str_eq(ch, "\\") == true {
                                    if j + 1 < end {
                                        val = str_concat(val, sh_esc_val(str_char_at(src, j + 1)));
                                        j = j + 2;
                                    } else {
                                        val = str_concat(val, ch);
                                        j = j + 1;
                                    }
                                } else {
                                    val = str_concat(val, ch);
                                    j = j + 1;
                                }
                            }
                            if closed == true {
                                sh_emit("string literal", val, tline, tcol);
                                let adv = end + 1 - pos;
                                pos = end + 1;
                                col = col + adv;
                            } else {
                                sh_emit("unknown", val, tline, tcol);
                                let adv2 = end - pos;
                                pos = end;
                                col = col + adv2;
                            }
                        } else {
                            if str_eq(c, "/") == true {
                                let next = "";
                                if pos + 1 < n {
                                    next = str_char_at(src, pos + 1);
                                }
                                if str_eq(next, "/") == true {
                                    let end = pos + 2;
                                    let lim = n;
                                    while end < lim {
                                        if str_eq(str_char_at(src, end), "\n") == true {
                                            lim = end;
                                        } else {
                                            end = end + 1;
                                        }
                                    }
                                    col = col + (end - pos);
                                    pos = end;
                                } else {
                                    sh_emit("'/'", "/", line, col);
                                    pos = pos + 1;
                                    col = col + 1;
                                }
                            } else {
                                if str_eq(c, "!") == true {
                                    let next = "";
                                    if pos + 1 < n {
                                        next = str_char_at(src, pos + 1);
                                    }
                                    if str_eq(next, "=") == true {
                                        sh_emit("'!='", "!=", line, col);
                                        pos = pos + 2;
                                        col = col + 2;
                                    } else {
                                        sh_emit("unknown", "!", line, col);
                                        pos = pos + 1;
                                        col = col + 1;
                                    }
                                } else {
                                    let pair = "";
                                    if pos + 1 < n {
                                        pair = str_slice(src, pos, pos + 2);
                                    }
                                    if str_eq(pair, "==") == true {
                                        sh_emit("'=='", "==", line, col);
                                        pos = pos + 2;
                                        col = col + 2;
                                    } else {
                                        if str_eq(pair, "<=") == true {
                                            sh_emit("'<='", "<=", line, col);
                                            pos = pos + 2;
                                            col = col + 2;
                                        } else {
                                            if str_eq(pair, ">=") == true {
                                                sh_emit("'>='", ">=", line, col);
                                                pos = pos + 2;
                                                col = col + 2;
                                            } else {
                                                if str_eq(pair, "->") == true {
                                                    sh_emit("'->'", "->", line, col);
                                                    pos = pos + 2;
                                                    col = col + 2;
                                                } else {
                                                    if str_eq(pair, "=>") == true {
                                                        sh_emit("'=>'", "=>", line, col);
                                                        pos = pos + 2;
                                                        col = col + 2;
                                                    } else {
                                                        if str_contains("(){}[]:;, .+*?|<>=-", c) == true {
                                                            sh_emit(str_concat(str_concat("'", c), "'"), c, line, col);
                                                            pos = pos + 1;
                                                            col = col + 1;
                                                        } else {
                                                            sh_emit("unknown", c, line, col);
                                                            pos = pos + 1;
                                                            col = col + 1;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    sh_emit("end of file", "", line, col);
}
