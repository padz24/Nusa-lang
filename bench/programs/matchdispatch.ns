fn classify(x: i64) -> i64 {
    match x {
        0 => {
            return 0;
        },
        1 => {
            return 10;
        },
        2 => {
            return 20;
        },
        n if n > 100 => {
            return n;
        },
        _ => {
            return 0 - 1;
        },
    }
    return 0;
}
fn main() {
    let sum = 0;
    let i = 0;
    while i < 200000 {
        sum = sum + classify(i);
        i = i + 1;
    }
    print(sum);
}
