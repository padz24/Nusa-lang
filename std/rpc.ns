// JSON-RPC minimal atas TCP newline-delimited (murni Nusa).
//
// Framing: 1 baris JSON per pesan (lihat recv_line). Handler
// server menerima BARIS request mentah dan mengembalikan BARIS
// respons mentah; dispatch metode di dalam via json_get_string.
// String-only (biner butuh `ord`). Blocking tanpa timeout
// (tasks hanya i64 — komposisi timeout didokumentasikan di
// timeout.ns). `""` respons = gagal transport.
import net;
import json;
import string;
// Amplop request {"jsonrpc":"2.0","id":ID,"method":M,"params":P}.
fn rpc_request(id: i64, method: string, params: string) -> string {
    let a: string = str_concat("{\"jsonrpc\":\"2.0\",\"id\":", int_to_str(id));
    let b: string = str_concat(a, ",\"method\":\"");
    let c: string = str_concat(b, method);
    let d: string = str_concat(c, "\",\"params\":");
    let e: string = str_concat(d, params);
    return str_concat(e, "}");
}
// Amplop respons sukses {"jsonrpc":"2.0","id":ID,"result":R}.
fn rpc_response(id: i64, result: string) -> string {
    let a: string = str_concat("{\"jsonrpc\":\"2.0\",\"id\":", int_to_str(id));
    let b: string = str_concat(a, ",\"result\":");
    let c: string = str_concat(b, result);
    return str_concat(c, "}");
}
// Amplop respons gagal {"jsonrpc":"2.0","id":ID,"error":M}.
fn rpc_error(id: i64, msg: string) -> string {
    let a: string = str_concat("{\"jsonrpc\":\"2.0\",\"id\":", int_to_str(id));
    let b: string = str_concat(a, ",\"error\":\"");
    let c: string = str_concat(b, msg);
    return str_concat(c, "\"}");
}
// Ekstrak method / params-mentah / id / result dari amplop.
fn rpc_method(req: string) -> string {
    return json_get_string(req, "method");
}
// Params mentah (slice JSON apa adanya: objek/array/string/skalar;
// "" bila absen).
fn rpc_params(req: string) -> string {
    let v: i64 = json_find(req, "params");
    if v < 0 {
        return "";
    }
    return rpc_slice_value(req, v);
}
// Slice satu nilai JSON dari `v` (string-aware, seimbang).
fn rpc_slice_value(s: string, v: i64) -> string {
    let n: i64 = str_len(s);
    if v >= n {
        return "";
    }
    let c: string = str_char_at(s, v);
    if str_eq(c, "\"") {
        let q: i64 = v + 1;
        let done: bool = false;
        while done == false {
            if q >= n {
                done = true;
            } else {
                let d: string = str_char_at(s, q);
                if str_eq(d, "\\") {
                    q = q + 2;
                } else {
                    if str_eq(d, "\"") {
                        q = q + 1;
                        done = true;
                    } else {
                        q = q + 1;
                    }
                }
            }
        }
        return str_slice(s, v, q);
    }
    if str_eq(c, "{") {
        return rpc_balanced(s, v, "{", "}");
    }
    if str_eq(c, "[") {
        return rpc_balanced(s, v, "[", "]");
    }
    let e: i64 = v;
    let stop: bool = false;
    while stop == false {
        if e >= n {
            stop = true;
        } else {
            let d: string = str_char_at(s, e);
            if str_eq(d, ",") {
                stop = true;
            } else {
                if str_eq(d, "}") {
                    stop = true;
                } else {
                    if str_eq(d, "]") {
                        stop = true;
                    } else {
                        e = e + 1;
                    }
                }
            }
        }
    }
    return str_trim(str_slice(s, v, e));
}
// Slice seimbang dari pembuka (string-aware).
fn rpc_balanced(s: string, v: i64, open: string, close: string) -> string {
    let n: i64 = str_len(s);
    let depth: i64 = 0;
    let p: i64 = v;
    let done: bool = false;
    while done == false {
        if p >= n {
            done = true;
        } else {
            let c: string = str_char_at(s, p);
            if str_eq(c, "\"") {
                let q: i64 = p + 1;
                let qd: bool = false;
                while qd == false {
                    if q >= n {
                        qd = true;
                    } else {
                        let d: string = str_char_at(s, q);
                        if str_eq(d, "\\") {
                            q = q + 2;
                        } else {
                            if str_eq(d, "\"") {
                                q = q + 1;
                                qd = true;
                            } else {
                                q = q + 1;
                            }
                        }
                    }
                }
                p = q;
            } else {
                if str_eq(c, open) {
                    depth = depth + 1;
                } else {
                    if str_eq(c, close) {
                        depth = depth - 1;
                        if depth <= 0 {
                            p = p + 1;
                            done = true;
                        }
                    }
                }
                if done == false {
                    p = p + 1;
                }
            }
        }
    }
    return str_slice(s, v, p);
}
fn rpc_id(req: string) -> i64 {
    return json_get_int(req, "id");
}
fn rpc_result(resp: string) -> string {
    return json_get_string(resp, "result");
}
// Panggil: dial + kirim baris + baca baris + tutup.
// "" bila dial/kirim/gagal (tanpa beda vs hasil-kosong).
fn rpc_call(host: string, port: i64, method: string, params: string) -> string {
    let fd: i64 = dial(host, port);
    if fd < 0 {
        return "";
    }
    let id: i64 = 1;
    let req: string = str_concat(rpc_request(id, method, params), "\n");
    if send_str(fd, req) == false {
        close_conn(fd);
        return "";
    }
    let resp: string = recv_line(fd);
    close_conn(fd);
    return str_trim(resp);
}
// Layani SATU koneksi: accept + baca baris + handler + tulis baris.
// 0 ok, -1 gagal (pola http_serve_once; loop di pemanggil).
fn rpc_serve_once(port: i64, handler: fn(string) -> string) -> i64 {
    let srv: i64 = listen_on(port);
    if srv < 0 {
        return 0 - 1;
    }
    let c: i64 = accept_one(srv);
    if c < 0 {
        close_conn(srv);
        return 0 - 1;
    }
    let req: string = recv_line(c);
    if str_eq(req, "") {
        close_conn(c);
        close_conn(srv);
        return 0 - 1;
    }
    let resp: string = str_concat(handler(req), "\n");
    send_str(c, resp);
    close_conn(c);
    close_conn(srv);
    return 0;
}
