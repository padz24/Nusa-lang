// Static service discovery (pure Nusa, no imports).
//
// Daftar endpoint statis (teks `"host:port"`, 1/baris —
// CSV satu kolom sehingga svc_* komposabel dengan csv.ns).
// Counter round-robin di-threading pemanggil (tanpa global).
// IPv4/hostname; IPv6 literal tak didukung (split `:` pertama).
// Jumlah endpoint (0 bila daftar kosong).
fn svc_count(list: string) -> i64 {
    let n: i64 = str_len(list);
    if n <= 0 {
        return 0;
    }
    let c: i64 = 1;
    let i: i64 = 0;
    while i < n {
        if str_eq(str_char_at(list, i), "\n") {
            c = c + 1;
        }
        i = i + 1;
    }
    if str_eq(str_char_at(list, n - 1), "\n") {
        c = c - 1;
    }
    return c;
}
// Endpoint ke-`i` (modulo jumlah; "" bila daftar kosong).
fn svc_at(list: string, i: i64) -> string {
    let c: i64 = svc_count(list);
    if c <= 0 {
        return "";
    }
    let k: i64 = i;
    if k < 0 {
        k = 0 - k;
    }
    let want: i64 = k - (k / c) * c;
    let n: i64 = str_len(list);
    let r: i64 = 0;
    let s: i64 = 0;
    let p: i64 = 0;
    while p <= n {
        if p >= n {
            if r == want {
                return svc_trim_cr(str_slice(list, s, n));
            }
            p = n + 1;
        } else {
            if str_eq(str_char_at(list, p), "\n") {
                if r == want {
                    return svc_trim_cr(str_slice(list, s, p));
                }
                r = r + 1;
                s = p + 1;
                p = p + 1;
            } else {
                p = p + 1;
            }
        }
    }
    return "";
}
// Tanpa `\r` akhir (toleransi CRLF).
fn svc_trim_cr(s: string) -> string {
    let n: i64 = str_len(s);
    if n > 0 {
        if str_eq(str_char_at(s, n - 1), "\r") {
            return str_slice(s, 0, n - 1);
        }
    }
    return s;
}
// Host dari `"host:port"` (utuh bila tanpa `:`).
fn svc_host(ep: string) -> string {
    let n: i64 = str_len(ep);
    let i: i64 = 0;
    while i < n {
        if str_eq(str_char_at(ep, i), ":") {
            return str_slice(ep, 0, i);
        }
        i = i + 1;
    }
    return ep;
}
// Port dari `"host:port"` (-1 bila absen/bukan angka).
fn svc_port(ep: string) -> i64 {
    let n: i64 = str_len(ep);
    let i: i64 = 0;
    while i < n {
        if str_eq(str_char_at(ep, i), ":") {
            let rest: string = str_slice(ep, i + 1, n);
            if parse_int_valid(rest) {
                return parse_int(rest);
            }
            return 0 - 1;
        }
        i = i + 1;
    }
    return 0 - 1;
}
// Round-robin: endpoint ke-`n` (counter di pemanggil).
fn svc_round_robin(list: string, n: i64) -> string {
    return svc_at(list, n);
}
