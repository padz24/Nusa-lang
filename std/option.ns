// Option<T>: nilai yang mungkin absen.
//
// 2.0 (BREAKING dari encoding struct v1.x — lihat
// docs/migration-2.0.md): enum natif. Konstruksi `Some` via `some(v)`
// (inferensi) atau `Option<T>.Some(v)`; `None` via `Option<T>.None()`
// (tipe eksplisit wajib — cermin literal `[]` yang butuh anotasi).
// Tanpa dummy. Pencocokan via `match` (exhaustiveness varian).
enum Option<T> {
    Some(T), None
}
// Bungkus nilai menjadi Some.
fn some<T>(value: T) -> Option<T> {
    return Option < T > .Some(value);
}
fn is_some<T>(o: Option<T>) -> bool {
    match o {
        Some(_) => {
            return true;
        },
        None => {
            return false;
        },
    }
    return false;
}
fn is_none<T>(o: Option<T>) -> bool {
    return is_some(o) == false;
}
fn opt_unwrap_or<T>(o: Option<T>, fallback: T) -> T {
    match o {
        Some(v) => {
            return v;
        },
        None => {
            return fallback;
        },
    }
    return fallback;
}
// Tanpa dummy (2.0): `opt_map(o, f)`.
fn opt_map<T, U>(o: Option<T>, f: fn(T) -> U) -> Option<U> {
    match o {
        Some(v) => {
            return Option < U > .Some(f(v));
        },
        None => {
            return Option < U > .None();
        },
    }
    return Option < U > .None();
}
// Validasi angka desimal penuh (lihat `parse_int_valid`).
// `parse_int` lama memberi 0 untuk input invalid (tak bisa bedakan
// "0" dari "abc"); fungsi ini mengembalikan None untuk invalid.
fn parse_int_opt(s: string) -> Option<i64> {
    if parse_int_valid(s) {
        return some(parse_int(s));
    }
    return Option < i64 > .None();
}
// Baca file sebagai Option: None bila hilang/tak terbaca.
fn file_read_opt(path: string) -> Option<string> {
    if file_exists(path) {
        return some(file_read(path));
    }
    return Option < string > .None();
}
