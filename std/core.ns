// Integer core utilities (pure Nusa, no builtins needed).
//
// Companion to `math.ns` (abs/min/max/clamp/pow/fact/gcd/is_even/
// isqrt live there): this module holds Euclidean division, bit-free
// powers of two, and small combinators. All functions work on `i64`.
// Overflow wraps (no trap); keep inputs in range (see `powmod`).
// Sign of `n`: -1, 0, or 1.
fn sign(n: i64) -> i64 {
    if n < 0 {
        return 0 - 1;
    }
    if n > 0 {
        return 1;
    }
    return 0;
}
// Absolute difference |a - b| (wraps on extreme inputs, like abs).
fn abs_diff(a: i64, b: i64) -> i64 {
    if a > b {
        return a - b;
    }
    return b - a;
}
// Ceiling division for b > 0 (b <= 0 gives 0).
fn ceil_div(a: i64, b: i64) -> i64 {
    if b <= 0 {
        return 0;
    }
    let q: i64 = a / b;
    let r: i64 = a - q * b;
    if r == 0 {
        return q;
    }
    if r > 0 {
        return q + 1;
    }
    return q;
}
// Euclidean remainder in [0, b) for b > 0 (b <= 0 gives 0).
// Unlike truncating `-`, always non-negative (see math.is_even).
fn mod_euclid(a: i64, b: i64) -> i64 {
    if b <= 0 {
        return 0;
    }
    let r: i64 = a - (a / b) * b;
    if r < 0 {
        return r + b;
    }
    return r;
}
// Euclidean quotient paired with mod_euclid: a == div_euclid(a,b)*b
// + mod_euclid(a,b) for b > 0 (b <= 0 gives 0).
fn div_euclid(a: i64, b: i64) -> i64 {
    if b <= 0 {
        return 0;
    }
    let q: i64 = a / b;
    let r: i64 = a - q * b;
    if r < 0 {
        return q - 1;
    }
    return q;
}
// Modular power (base^exp mod m; exp >= 0, m > 0; else 0).
// Overflow wraps mid-loop, so keep base*base in range.
fn powmod(base: i64, exp: i64, m: i64) -> i64 {
    if exp < 0 {
        return 0;
    }
    if m <= 0 {
        return 0;
    }
    let r: i64 = mod_euclid(1, m);
    let b: i64 = mod_euclid(base, m);
    let e: i64 = exp;
    while e > 0 {
        if mod_euclid(e, 2) == 1 {
            r = mod_euclid(r * b, m);
        }
        b = mod_euclid(b * b, m);
        e = e / 2;
    }
    return r;
}
// Floor of log2 (ilog2(1) is 0; n <= 0 gives 0).
fn ilog2(n: i64) -> i64 {
    if n <= 0 {
        return 0;
    }
    let r: i64 = 0;
    let x: i64 = n;
    while x > 1 {
        x = x / 2;
        r = r + 1;
    }
    return r;
}
// True for exact powers of two (1, 2, 4, ...; else false).
fn is_pow2(n: i64) -> bool {
    if n <= 0 {
        return false;
    }
    let x: i64 = n;
    while x > 1 {
        if mod_euclid(x, 2) != 0 {
            return false;
        }
        x = x / 2;
    }
    return true;
}
// Sum 1 + 2 + ... + n (n <= 0 gives 0; wraps past i64 range).
fn sum_to(n: i64) -> i64 {
    if n <= 0 {
        return 0;
    }
    return n * (n + 1) / 2;
}
