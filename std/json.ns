// JSON datar (objek top-level), murni Nusa.
//
// Gaya getter: skalar per kunci (first-match, top-level SAJA;
// kunci bersarang/array diabaikan). Getter tak membedakan
// "hilang" vs "tipe-salah" (lihat json_has_key):
// string → "" ; int → 0 ; bool → false.
// Angka: prefix integer (+/- digit; desimal dipotong');
// string di-unescape (cermin lexer); `null`/komposit → kosong.
import string;
fn json_unescape(raw: string) -> string {
    let out: string = "";
    let n: i64 = str_len(raw);
    let i: i64 = 0;
    while i < n {
        let c: string = str_char_at(raw, i);
        if str_eq(c, "\\") {
            if i + 1 < n {
                let e: string = str_char_at(raw, i + 1);
                if str_eq(e, "n") {
                    out = str_concat(out, "\n");
                } else {
                    if str_eq(e, "t") {
                        out = str_concat(out, "\t");
                    } else {
                        if str_eq(e, "r") {
                            out = str_concat(out, "\r");
                        } else {
                            out = str_concat(out, e);
                        }
                    }
                }
                i = i + 2;
            } else {
                out = str_concat(out, c);
                i = i + 1;
            }
        } else {
            out = str_concat(out, c);
            i = i + 1;
        }
    }
    return out;
}
// Lewati spasi dari `p` (set str_is_blank).
fn json_ws(s: string, p: i64) -> i64 {
    let n: i64 = str_len(s);
    let i: i64 = p;
    let done: bool = false;
    while done == false {
        if i >= n {
            done = true;
        } else {
            if str_is_blank(str_char_at(s, i)) {
                i = i + 1;
            } else {
                done = true;
            }
        }
    }
    return i;
}
// Posisi awal nilai untuk `key` top-level (-1 bila absen).
fn json_find(obj: string, key: string) -> i64 {
    let n: i64 = str_len(obj);
    let depth: i64 = 0;
    let p: i64 = 0;
    while p < n {
        let c: string = str_char_at(obj, p);
        if str_eq(c, "\"") {
            let q: i64 = p + 1;
            let done: bool = false;
            while done == false {
                if q >= n {
                    done = true;
                } else {
                    let d: string = str_char_at(obj, q);
                    if str_eq(d, "\\") {
                        q = q + 2;
                    } else {
                        if str_eq(d, "\"") {
                            q = q + 1;
                            done = true;
                        } else {
                            q = q + 1;
                        }
                    }
                }
            }
            let word: string = json_unescape(str_slice(obj, p + 1, q - 1));
            p = q;
            if depth == 1 {
                let r: i64 = json_ws(obj, p);
                if r < n {
                    if str_eq(str_char_at(obj, r), ":") {
                        if str_eq(word, key) {
                            return json_ws(obj, r + 1);
                        }
                    }
                }
            }
        } else {
            if str_eq(c, "{") {
                depth = depth + 1;
            } else {
                if str_eq(c, "[") {
                    depth = depth + 1;
                } else {
                    if str_eq(c, "}") {
                        depth = depth - 1;
                    } else {
                        if str_eq(c, "]") {
                            depth = depth - 1;
                        }
                    }
                }
            }
            p = p + 1;
        }
    }
    return 0 - 1;
}
// True bila kunci top-level ada (apa pun nilainya).
fn json_has_key(obj: string, key: string) -> bool {
    return json_find(obj, key) != 0 - 1;
}
// Nilai string (decode) atau "".
fn json_get_string(obj: string, key: string) -> string {
    let v: i64 = json_find(obj, key);
    if v < 0 {
        return "";
    }
    if v >= str_len(obj) {
        return "";
    }
    if str_eq(str_char_at(obj, v), "\"") == false {
        return "";
    }
    let q: i64 = v + 1;
    let n: i64 = str_len(obj);
    let done: bool = false;
    while done == false {
        if q >= n {
            done = true;
        } else {
            let d: string = str_char_at(obj, q);
            if str_eq(d, "\\") {
                q = q + 2;
            } else {
                if str_eq(d, "\"") {
                    done = true;
                } else {
                    q = q + 1;
                }
            }
        }
    }
    return json_unescape(str_slice(obj, v + 1, q));
}
// Prefix integer (tanda + digit; else 0).
fn json_get_int(obj: string, key: string) -> i64 {
    let v: i64 = json_find(obj, key);
    if v < 0 {
        return 0;
    }
    let n: i64 = str_len(obj);
    let e: i64 = v;
    if e < n {
        if str_eq(str_char_at(obj, e), "-") {
            e = e + 1;
        } else {
            if str_eq(str_char_at(obj, e), "+") {
                e = e + 1;
            }
        }
    }
    let s: i64 = e;
    let done: bool = false;
    while done == false {
        if e >= n {
            done = true;
        } else {
            let d: string = str_char_at(obj, e);
            if str_contains("0123456789", d) {
                e = e + 1;
            } else {
                done = true;
            }
        }
    }
    if e <= s {
        return 0;
    }
    return parse_int(str_slice(obj, v, e));
}
// True hanya untuk literal `true`.
fn json_get_bool(obj: string, key: string) -> bool {
    let v: i64 = json_find(obj, key);
    if v < 0 {
        return false;
    }
    if v + 4 > str_len(obj) {
        return false;
    }
    return str_eq(str_slice(obj, v, v + 4), "true");
}
// Cek dangkal: kurung {}[] seimbang di luar string + tak-kosong.
fn json_valid(s: string) -> bool {
    let t: string = str_trim(s);
    if str_eq(t, "") {
        return false;
    }
    let n: i64 = str_len(t);
    let depth: i64 = 0;
    let p: i64 = 0;
    while p < n {
        let c: string = str_char_at(t, p);
        if str_eq(c, "\"") {
            let q: i64 = p + 1;
            let done: bool = false;
            while done == false {
                if q >= n {
                    return false;
                }
                let d: string = str_char_at(t, q);
                if str_eq(d, "\\") {
                    q = q + 2;
                } else {
                    if str_eq(d, "\"") {
                        q = q + 1;
                        done = true;
                    } else {
                        q = q + 1;
                    }
                }
            }
            p = q;
        } else {
            if str_eq(c, "{") {
                depth = depth + 1;
            } else {
                if str_eq(c, "[") {
                    depth = depth + 1;
                } else {
                    if str_eq(c, "}") {
                        depth = depth - 1;
                    } else {
                        if str_eq(c, "]") {
                            depth = depth - 1;
                        }
                    }
                }
            }
            if depth < 0 {
                return false;
            }
            p = p + 1;
        }
    }
    return depth == 0;
}
