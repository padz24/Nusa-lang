// Sample `nusa test` target: retry + timeout + discovery.
import retry;
import timeout;
import discovery;
import tasks;
fn fast() -> i64 {
    return 7;
}
fn slow() -> i64 {
    sleep_ms(500);
    return 1;
}
fn is_neg(r: i64) -> bool {
    return r < 0;
}
fn flaky() -> i64 {
    let n: i64 = parse_int(file_read("counter.txt"));
    file_write("counter.txt", int_to_str(n + 1));
    if n < 2 {
        return 0 - 1;
    }
    return 42;
}
fn main() {
    assert(with_timeout_ms(500, fast, 0 - 1) == 7);
    assert(with_timeout_ms(50, slow, 0 - 1) == 0 - 1);
    file_write("counter.txt", "0");
    assert(retry_with(retry_default(), flaky, is_neg) == 42);
    assert(str_eq(svc_at("a:1\nb:2", 3), "b:2"));
    assert(str_eq(svc_host("h:9"), "h"));
    assert(svc_port("h:9") == 9);
    assert(svc_port("nope") == 0 - 1);
    assert(svc_count("") == 0);
}
