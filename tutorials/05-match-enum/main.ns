enum Color {
    Red, Green, Blue
}
fn code(c: Color) -> i64 {
    match c {
        Red => {
            return 1;
        },
        Green => {
            return 2;
        },
        Blue => {
            return 3;
        },
    }
    return 0;
}
fn f(x: i64) -> i64 {
    match x {
        1 => {
            return 10;
        },
        2 => {
            return 20;
        },
        _ => {
            return 30;
        },
    }
    return 0;
}
fn main() {
    print(code(Color.Red));
    print(code(Color.Green));
    print(f(1));
    print(f(9));
}
